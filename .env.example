# Copy to .env. With MOCK_MODE=true nothing below except FalkorDB is required.
MOCK_MODE=true

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

RESEND_API_KEY=
FROM_EMAIL=wingman@yourdomain.com   # must be on a domain verified in Resend
SEND_TEST_TO=                        # rehearsal: set to your own email and every approved draft goes there

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000   # FalkorDB browser; change if 3000 is taken (docker compose reads this)
GRAPH_NAME=wingman

USER_ID=me
USER_NAME=Your Name
USER_SKILLS="CUDA,Python,LLM inference"
RESUME_URL=https://example.com/resume.pdf
DECK_URL=https://example.com/deck.pdf
DEMO_URL=https://example.com/demo
# Links for things you promise in conversation (keyword=url, comma separated). resume/deck/demo are built in.
ASSET_LINKS=repo=https://github.com/you/cuda-bench,notes=https://example.com/tensorrt-int8-notes
EVENT_NAME=the conference
